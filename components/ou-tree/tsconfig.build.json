{
    "extends": "./tsconfig.json",
    "compilerOptions": {
        "noEmit": false,
        "declaration": true,
        "emitDeclarationOnly": true,
        "rootDir": "src",
        "outDir": "build/types"
    },
    "include": ["src", "typings"],
    "exclude": [
        "src/locales",
        "**/*.test.ts",
        "**/*.test.tsx",
        "**/*.stories.tsx"
    ]
}
