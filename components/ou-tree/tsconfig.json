{
    "compilerOptions": {
        "strict": true,
        "noEmit": true,
        "skipLibCheck": true,
        "jsx": "react",
        "target": "ES2020",
        "module": "ESNext",
        "moduleResolution": "node",
        "esModuleInterop": true,
        "forceConsistentCasingInFileNames": true,
        "isolatedModules": true,
        "noUnusedLocals": true,
        "noUnusedParameters": true
    },
    "include": ["src", "typings"],
    "exclude": ["src/locales"]
}
